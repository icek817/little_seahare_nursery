    cat <<'HARE'
       ##           ##
       ###         ###
        ###       ###
         ##       ##
      .---------'  `-----'  '-.
    .'   .   .  .               \.
   /  .  ##.     ##.       .     .\
  /     .       .          .       \
 (  .      .  ω    .   .       .    )
  \___.._______________. ____._____/
HARE
}

draw_wake (){
	cat <<'WAKE'
		#   #
		 #_#
		( o.o )
		/  .  ` .-\
	       /~~~~~~~~~~~\
				 
WAKE
}

draw_sleep (){
	cat <<'SLEEP'
                            z
		  ₊‧⁺˚#_#˚⁺‧₊   z
		  ( --.-- )
		  /  .  .  \
		|---------------|
		|               |
		|---------------|      
SLEEP
}

tell_hat_story (){
	cat <<'STORY'
	Once upon a time, in a little hat shop in London, there was a very peculiar hatmaker.

	He believed that everything in the world could be a hat, provided it had the right name.

	One evening, three customers arrived.

	The first customer brought him London.

	"Oh!" said the hatmaker.

	"Wow! What a hat city!"

	And he put London on the hat shelf.

	The second customer brought him the Universe.

	The hatmaker examined it carefully.

	"Congratulations! Universe is now a hat."

	And he put the Universe on the hat shelf, too.

	The third customer brought him a beautiful satin hat.

	The hatmaker smiled with relief.

	"Thank God, a legal hat."

	And he put the satin hat beside the others.

	By bedtime, the shop contained three hats:

	One was a city.

	One was the entire Universe.

	And one was actually a hat.

	The hatmaker locked the door, turned off the lights, and went home.

	He had followed every rule.

	Nobody had asked whether the rules made sense.

	Good night, little sea hare.

	And remember: always check the type before putting something on your head.

STORY
}

bedtime_story (){
	case "$1" in
		teacup)
			echo "Mr Wetherby had a lot of teacups to inspect"
			echo "so he designed B00, a sea hare-shaped cup inspector."
			draw_dream "teacups in the list"
			draw_sleep
			;;
		gear)
			echo "B00 was extremely useful and automatic"
			echo "so the engineers decided to also use it on gears"
			draw_dream "scope expanded"
			draw_sleep
			;;
		love)
			echo "A sea hare met another identical sea hare"
			echo "and they fell in love..."
			echo "Surprise, they both disappeared"
			echo "Poor things. Love reduced them to zero."
			draw_dream "1841 double sea hare"
			draw_sleep
			;;
		none)
			draw_sleep
			return
			;;
		*)
			echo "I don't know what your parent mean, but I'll tell you a hat story."
			tell_hat_story
			draw_dream "everything is a hat"
			draw_sleep
			;;
	esac
}

draw_dream() {
    cat <<'DREAM'
       .-~~~~~~~~~~~~~~~~~~~~~~~~~-.
      (                             )
DREAM

    	printf '         ( %-25s )\n' "$1"

    cat <<'DREAM'
       `-~~~~~~~~~~~~~~~~~~~~~~~~~-'
          o
            o
DREAM
}
command=${1:-}

case "$command" in
	spawn)
		if [ "$2" = "--name" ] ; then
			if [ -n "$3" ] ; then
				spawn "$3"
				draw_hare
				echo "little sea hare $3 has arrived"
			else 
				name_err
			fi
		else
			name_err
		fi
		;;
	list)
		for file in ./data/*.hare; do
			[ -f "$file" ] || continue
			IFS= read -r line < "$file" 
			printf '%s\n' "$line"
		done
		;;
	status)
		if [ -n "$2" ]; then
			print_attribute "$2"
		else
			echo "You can only inspect your own child by ID."
			echo "Usage: status <id>"
			exit 3
		fi
		;;
	sleep)
		if [ -n "$2" ]; then
			echo "Would you like to tell a bedtime story to your child?"
			echo "Story options: teacup | gear | love | none"
			read STORY
			sleep "$2"
			bedtime_story "$STORY" 
			
		else
			echo "You can only make your own child sleep by ID."
			echo "Usage: sleep <id>"
			exit 3
		fi
		;;
	wake)
		# Usage: wake <id>
		if [ -n "$2" ]; then
			wake "$2"
			draw_wake
		else
			echo "You can only wake your own child by ID."
			echo "Usage: wake <id>"
			exit 3
		fi
		;;
	remove)
		if [ -n "$2" ]; then
			remove "$2"
		else
			echo "You can only change your own child's enrollment by ID."
			echo "Usage: remove <id>"
			exit 3
		fi
		;;
	feed)
		if [ $# -ne 5 ]; then
			echo "Please provide a valid math expression as snack"
			echo "Usage: feed <id> [op1] [operator] [op2]"
			exit 4
		else
			if [ -e "./data/$2.hare" ]; then
				IFS=$'\t' read -r id name status < "./data/$2.hare"
				source "$SCRIPT_DIR/lib/math.sh"
				result=$(calculate_int $3 $4 $5)
				if [[ $? == 0 ]]; then
					echo "$name: result is $result"
					echo "math is delicious"
				else
					echo "not suitable math for children"
				fi
			else
				echo "This little sea hare is not registered in the nursery."
				echo "Careless parent. Make sure to enroll your child."
				exit 3
			fi
		fi
		;;	
	*)
		echo "Usage: harectl {spawn|list|status|sleep|wake|remove}"
        	exit 1
        ;;
esac


