#!/bin/bash

base_id="001"
spawn() {

	name="$1"
	status="sleeping"

	mkdir -p ./data
	if [ -e "./data/next_id" ] ; then
		mapfile -t COUNTER < ./data/next_id
		id="${COUNTER[0]}"
		
	else
		id="$base_id"
	fi
	printf '%s\t%s\t%s\n' "$id" "$name" "$status" > "./data/$id.hare"
	id=$((10#id+1))
	printf '%03d\n' "$id" > ./data/next_id
}

name_err() {
	echo "The nursery requires a name for enrolling your sea hare."
	echo "Usage: --name <name>"
	exit 2
}

print_attribute() {
	if [ -e "./data/$1.hare" ]; then

		IFS= read -r line < "./data/$1.hare" # id here
		read -ra arr <<< "$line"
		name="${arr[1]}"
		status="${arr[2]}"
		echo "$name, mummy just came to see if you're doing well."
		echo "Little sea hare $name is $status."
	else
		echo "This little sea hare is not registered in the nursery."
		echo "Careless parent. Make sure to enroll your child."
		exit 3
	fi
}

wake() {
	if [ -e "./data/$1.hare" ]; then
		IFS= read -r line < "./data/$1.hare"
		read -ra arr <<< "$line"
		name="${arr[1]}"
		status="${arr[2]}"
		if [ "$status" = "sleeping" ]; then
			status="awake"
			echo "$name, wake up! Time for some math snack."
			printf '%s\t%s\t%s\n' "$1" "$name" "$status" > "./data/$1.hare"
			echo "$name: \"mmmm, I'm waking.\""
			echo "$name is now awake."
		else
			echo "$name is awake and very enthusiastic!"
		fi
	else
		echo "This little sea hare is not registered in the nursery."
		echo "Careless parent. Make sure to enroll your child."
		exit 3
	fi

} 

sleep() {
	if [ -e "./data/$1.hare" ]; then
		IFS= read -r line < "./data/$1.hare"
		read -ra arr <<< "$line"
		name="${arr[1]}"
		status="${arr[2]}"
		if [ "$status" = "awake" ]; then
			status="sleeping"
			echo "$name, you're a very good sea hare. Time to bed."
			printf '%s\t%s\t%s\n' "$1" "$name" "$status" > "./data/$1.hare"
			echo "$name: \"I want another bedtime story...\""
			echo "$name is now asleep."
		else
			echo "$name is sleeping, do not disturb her dream."
		fi
	else
		echo "This little sea hare is not registered in the nursery."
		echo "Careless parent. Make sure to enroll your child."
		exit 3
	fi

} 
command=${1:-}

case "$command" in
	spawn)
		if [ "$2" = "--name" ] ; then
			if [ -n "$3" ] ; then
				spawn "$3"

			else 
				name_err
			fi
		else
			name_err
		fi
		;;
	list)
		for file in ./data/*.hare; do
			[ -f "$file" ] || continue
			IFS= read -r line < "$file" 
			printf '%s\n' "$line"
		done
		;;
	status)
		if [ -n "$2"]; then
			print_attribute "$2"
		else
			echo "You can only inspect your own child by ID."
			echo "Usage: status <id>"
			exit 3
		fi
		;;
	sleep)
		if [ -n "$2" ]; then
			sleep "$2"
		else
			echo "You can only inspect your own child by ID."
			echo "Usage: sleep <id>"
			exit 3
		fi
		;;
	wake)
		# Usage: wake <id>
		if [ -n "$2" ]; then
			wake "$2"
		else
			echo "You can only inspect your own child by ID."
			echo "Usage: wake <id>"
			exit 3
		fi
		;;
	remove)
		echo "TODO: delete an instance"
		;;
	*)
		echo "Usage: harectl {spawn|list|status|sleep|wake|remove}"
        	exit 1
        	;;
esac
